<Project Sdk="Microsoft.NET.Sdk">
  <!-- The CLI and PDF tests of tests/PdfNotes.Tests (its files, linked) for Windows, Linux and macOS in the check
       workflow, with the fonts each system has. Not part of the solution:
         dotnet test tests/PdfNotes.Cli.Tests -c Release -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <RootNamespace>PdfNotes.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="../../tools/PdfNotes.Cli/PdfNotes.Cli.csproj" />
    <ProjectReference Include="../../src/PdfNotes.Text.Skia/PdfNotes.Text.Skia.csproj" />
    <ProjectReference Include="../../src/PdfNotes.Editor/PdfNotes.Editor.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../PdfNotes.Tests/Cli/*.cs" Link="Cli/%(Filename)%(Extension)" />
    <Compile Include="../PdfNotes.Tests/Pdf/*.cs" Exclude="../PdfNotes.Tests/Pdf/ImagePdfTests.cs;../PdfNotes.Tests/Pdf/SaveCompatibilityTests.cs;../PdfNotes.Tests/Pdf/TextPdfTests.cs" Link="Pdf/%(Filename)%(Extension)" />
    <Compile Include="../PdfNotes.Tests/Core/TestModels.cs;../PdfNotes.Tests/Core/ShapeTests.cs;../PdfNotes.Tests/Core/TextEditingTests.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../PdfNotes.Tests/TextEngine/LineBreakerTests.cs" Link="TextEngine/LineBreakerTests.cs" />
  </ItemGroup>
</Project>
