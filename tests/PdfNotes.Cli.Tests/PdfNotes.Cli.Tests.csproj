<Project Sdk="Microsoft.NET.Sdk">
  <!-- Roadmap P2 S7: the CLI and PDF tests against the WPF-free CLI (-p:DeotEngine=Skia), for Windows, Linux and macOS in
       the check workflow. The test files are the Windows test project's, compiled with DEOT_SKIA. Not part of the
       solution. Build and run with the property set for every project (restore does not pass a reference's own):
         dotnet test tests/PdfNotes.Cli.Tests -c Release -p:DeotEngine=Skia -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <DefineConstants>$(DefineConstants);DEOT_SKIA</DefineConstants>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <RootNamespace>PdfNotes.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="bblanchon.PDFium.Linux" Version="156.0.8076" />
    <PackageReference Include="bblanchon.PDFium.macOS" Version="156.0.8076" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="../../tools/PdfNotes.Cli/PdfNotes.Cli.csproj" />
    <ProjectReference Include="../../src/PdfNotes.Text.Skia/PdfNotes.Text.Skia.csproj" />
    <ProjectReference Include="../../src/PdfNotes.Editor/PdfNotes.Editor.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../PdfNotes.Tests/Cli/*.cs" Link="Cli/%(Filename)%(Extension)" />
    <Compile Include="../PdfNotes.Tests/Pdf/*.cs" Exclude="../PdfNotes.Tests/Pdf/ImagePdfTests.cs;../PdfNotes.Tests/Pdf/ProbePdfTests.cs;../PdfNotes.Tests/Pdf/SaveCompatibilityTests.cs;../PdfNotes.Tests/Pdf/TextPdfTests.cs" Link="Pdf/%(Filename)%(Extension)" />
    <Compile Include="../PdfNotes.Tests/Core/TestModels.cs;../PdfNotes.Tests/Core/ShapeTests.cs;../PdfNotes.Tests/Core/TextEditingTests.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../PdfNotes.Tests/TextEngine/LineBreakerTests.cs" Link="TextEngine/LineBreakerTests.cs" />
  </ItemGroup>
  <Target Name="RequireSkiaEngine" BeforeTargets="CollectPackageReferences;Build">
    <Error Condition="'$(DeotEngine)' != 'Skia'" Text="Build this project with -p:DeotEngine=Skia (the CLI under test is the WPF-free build)." />
  </Target>
</Project>
