<Project>
  <PropertyGroup>
    <Version>1.2.1</Version>
    <!-- File properties of every exe/dll: one product name and a plain version (no +commit), which code signing checks -->
    <Product>DeotPDF</Product>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- No default system: builds and tests run anywhere. The lock files cover the four release systems, so a locked
         restore works on each of them and for any of these publish targets (tools/package-release.ps1 -Rid). -->
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
</Project>
