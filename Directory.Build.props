<Project>
  <PropertyGroup>
    <Version>1.4.0</Version>
    <!-- File properties of every exe/dll: one product name and a plain version (no +commit), which code signing checks -->
    <Product>DeotPDF</Product>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The recommended code analysis rules (review 2026-11-08 D9); the ones turned off say why in .editorconfig. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- The XML comments are checked (broken cref, a param that does not exist); not every member needs one. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <!-- The comment files are for the build's check only, not for the release packages. -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- No default system: builds and tests run anywhere. The lock files cover the four release systems, so a locked
         restore works on each of them and for any of these publish targets (tools/package-release.ps1 -Rid). -->
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
</Project>
