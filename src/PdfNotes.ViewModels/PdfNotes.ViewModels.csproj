<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Plain IL for every system: an app that builds for one system (Android) uses the same build. -->
    <IsRidAgnostic>true</IsRidAgnostic><TargetFramework>net10.0</TargetFramework></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PdfNotes.Editor\PdfNotes.Editor.csproj" />
  </ItemGroup>
  <!-- Members the tests observe (the last menu opened, a paste in progress) stay internal. -->
  <ItemGroup>
    <InternalsVisibleTo Include="PdfNotes.Desktop.Tests" />
    <InternalsVisibleTo Include="PdfNotes.Tests" />
  </ItemGroup>
</Project>
