<Window x:Class="PdfNotes.App.Prototype.ProbeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PdfNotes — D01 PDF 검증" Width="1050" Height="850"
        MinWidth="640" MinHeight="420" Background="#F5F5F5">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="PdfNotes · PDF 저장 검증 시제품" FontSize="23" FontWeight="SemiBold" />
            <TextBlock Text="D01: 한글 · 투명 획 · PNG · 곡선 · 글자 좌표 / 최종 필기 화면은 이후 단계에서 구현"
                       Foreground="#555" Margin="0,6,0,14" />
            <WrapPanel Margin="0,0,0,12">
                <Button x:Name="CreateButton" Content="샘플 생성 / 저장" Click="CreateClick" Padding="12,7" Margin="0,0,8,0" />
                <Button x:Name="OpenButton" Content="저장본 재열기" Click="OpenClick" Padding="12,7" Margin="0,0,8,0" />
                <Button x:Name="EditButton" Content="획 색 / 굵기 변경 후 저장" Click="EditClick" Padding="12,7" Margin="0,0,8,0" />
                <Button x:Name="FlattenButton" Content="별도 Flatten PDF" Click="FlattenClick" Padding="12,7" />
            </WrapPanel>
            <WrapPanel Margin="0,0,0,12">
                <TextBlock Text="검증 페이지:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="PageChoice" Width="280" SelectedIndex="0" SelectionChanged="PageChanged">
                    <ComboBoxItem Content="1 · 기본 좌표" />
                    <ComboBoxItem Content="2 · CropBox + 90° + UserUnit 2" />
                    <ComboBoxItem Content="3 · CropBox + 270°" />
                </ComboBox>
            </WrapPanel>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" x:Name="Status" Text="샘플을 생성하면 복원한 편집 데이터로 화면을 그립니다."
                   TextWrapping="Wrap" Margin="0,12,0,0" />
        <Border Background="#DDD" Padding="12">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Image x:Name="Preview" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
