<!--
  강조색 사전 (spec 3.1, D13a): 사용자가 고르는 한 가지 강조색. 각 색은 밝은 테마용과 어두운 테마용(더 밝은 색)을 둔다.
  Theme.cs가 현재 테마·강조색으로 Accent / Accent.Subtle / Accent.Foreground 붓을 만든다. 기본은 파랑.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Accent.Blue.Light">#1E6FD9</Color>
    <Color x:Key="Accent.Blue.Dark">#5B9EF0</Color>
    <Color x:Key="Accent.Green.Light">#1B8A4B</Color>
    <Color x:Key="Accent.Green.Dark">#4CC07A</Color>
    <Color x:Key="Accent.Purple.Light">#7B3FD1</Color>
    <Color x:Key="Accent.Purple.Dark">#A780F0</Color>
    <Color x:Key="Accent.Orange.Light">#D2650A</Color>
    <Color x:Key="Accent.Orange.Dark">#F4A04A</Color>
    <Color x:Key="Accent.Red.Light">#C8323C</Color>
    <Color x:Key="Accent.Red.Dark">#F06B73</Color>
    <Color x:Key="Accent.Gray.Light">#5F6670</Color>
    <Color x:Key="Accent.Gray.Dark">#A3AAB4</Color>

    <!-- 강조색 위의 글자·체크 표시 -->
    <Color x:Key="Accent.Foreground.Light">#FFFFFF</Color>
    <Color x:Key="Accent.Foreground.Dark">#101010</Color>
</ResourceDictionary>
