<!--
  밝은 테마 색 토큰 (spec 3.1·3.2, D13a): 앱 틀(창·도구 모음·패널·대화상자·메뉴)과 문서 바깥 배경만.
  종이와 주석 색은 테마로 바꾸지 않는다(Canvas.xaml). 키는 Dark.xaml과 같아야 한다(ThemeTests).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">
    <!-- 면 -->
    <SolidColorBrush x:Key="Window.Background" Color="#FAFAFA" po:Freeze="True" />
    <SolidColorBrush x:Key="Bar.Background" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="SubBar.Background" Color="#FCFCFC" po:Freeze="True" />
    <SolidColorBrush x:Key="Panel.Background" Color="#F3F3F4" po:Freeze="True" />
    <SolidColorBrush x:Key="Surface.Background" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Canvas.Background" Color="#E8E8EA" po:Freeze="True" />

    <!-- 선 -->
    <SolidColorBrush x:Key="Divider" Color="#E0E0E0" po:Freeze="True" />
    <SolidColorBrush x:Key="Border" Color="#C8C8C8" po:Freeze="True" />

    <!-- 글자 -->
    <SolidColorBrush x:Key="Text.Primary" Color="#202020" po:Freeze="True" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#444444" po:Freeze="True" />
    <SolidColorBrush x:Key="Text.Muted" Color="#666666" po:Freeze="True" />
    <SolidColorBrush x:Key="Text.Disabled" Color="#A0A0A0" po:Freeze="True" />
    <SolidColorBrush x:Key="Text.Danger" Color="#B00020" po:Freeze="True" />

    <!-- 컨트롤 -->
    <SolidColorBrush x:Key="Control.Background" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Control.Border" Color="#B4B4B8" po:Freeze="True" />
    <SolidColorBrush x:Key="Control.Hover" Color="#E6E6E6" po:Freeze="True" />
    <SolidColorBrush x:Key="Control.Pressed" Color="#D6D6D6" po:Freeze="True" />
    <SolidColorBrush x:Key="Button.Background" Color="#F5F5F5" po:Freeze="True" />
    <SolidColorBrush x:Key="Swatch.Outline" Color="#40000000" po:Freeze="True" />
    <SolidColorBrush x:Key="Swatch.Hover" Color="#C0C0C0" po:Freeze="True" />
    <SolidColorBrush x:Key="ScrollBar.Track" Color="#F0F0F0" po:Freeze="True" />
    <SolidColorBrush x:Key="ScrollBar.Thumb" Color="#C2C2C2" po:Freeze="True" />
    <SolidColorBrush x:Key="ScrollBar.ThumbHover" Color="#A6A6A6" po:Freeze="True" />

    <!-- 문서 영역의 종이 틀 -->
    <SolidColorBrush x:Key="Page.Shadow" Color="#30000000" po:Freeze="True" />
    <SolidColorBrush x:Key="Page.Border" Color="#C8C8C8" po:Freeze="True" />
</ResourceDictionary>
