<!--
  어두운 테마 색 토큰 (spec 3.2, D13a): Light.xaml과 같은 키. 문서 바깥 배경만 어두워지고 종이·주석 색은 그대로다.
  설정 창의 선택(밝게/어둡게/Windows 따르기)은 D13d에서 연결한다.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">
    <SolidColorBrush x:Key="Window.Background" Color="#202020" po:Freeze="True" />
    <SolidColorBrush x:Key="Bar.Background" Color="#2B2B2B" po:Freeze="True" />
    <SolidColorBrush x:Key="SubBar.Background" Color="#272727" po:Freeze="True" />
    <SolidColorBrush x:Key="Panel.Background" Color="#242424" po:Freeze="True" />
    <SolidColorBrush x:Key="Surface.Background" Color="#2C2C2C" po:Freeze="True" />
    <SolidColorBrush x:Key="Canvas.Background" Color="#1A1A1A" po:Freeze="True" />

    <SolidColorBrush x:Key="Divider" Color="#3A3A3A" po:Freeze="True" />
    <SolidColorBrush x:Key="Border" Color="#4A4A4A" po:Freeze="True" />

    <SolidColorBrush x:Key="Text.Primary" Color="#EDEDED" po:Freeze="True" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#C8C8C8" po:Freeze="True" />
    <SolidColorBrush x:Key="Text.Muted" Color="#A0A0A0" po:Freeze="True" />
    <SolidColorBrush x:Key="Text.Disabled" Color="#6E6E6E" po:Freeze="True" />
    <SolidColorBrush x:Key="Text.Danger" Color="#FF8A80" po:Freeze="True" />

    <SolidColorBrush x:Key="Control.Background" Color="#1E1E1E" po:Freeze="True" />
    <SolidColorBrush x:Key="Control.Border" Color="#5C5C5C" po:Freeze="True" />
    <SolidColorBrush x:Key="Control.Hover" Color="#3A3A3A" po:Freeze="True" />
    <SolidColorBrush x:Key="Control.Pressed" Color="#464646" po:Freeze="True" />
    <SolidColorBrush x:Key="Button.Background" Color="#333333" po:Freeze="True" />
    <SolidColorBrush x:Key="Swatch.Outline" Color="#66FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Swatch.Hover" Color="#6E6E6E" po:Freeze="True" />
    <SolidColorBrush x:Key="ScrollBar.Track" Color="#262626" po:Freeze="True" />
    <SolidColorBrush x:Key="ScrollBar.Thumb" Color="#5A5A5A" po:Freeze="True" />
    <SolidColorBrush x:Key="ScrollBar.ThumbHover" Color="#7A7A7A" po:Freeze="True" />

    <SolidColorBrush x:Key="Page.Shadow" Color="#80000000" po:Freeze="True" />
    <SolidColorBrush x:Key="Page.Border" Color="#3A3A3A" po:Freeze="True" />
</ResourceDictionary>
