<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PdfNotes.Text\PdfNotes.Text.csproj" />
    <ProjectReference Include="..\PdfNotes.Core\PdfNotes.Core.csproj" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="bblanchon.PDFium.Win32" Version="156.0.8076" />
    <!-- D14a: PDFsharp needs Pkcs 8.0.1 (known vulnerabilities); on net10.0-windows the Windows Desktop runtime supplied it, on net10.0 a patched package must -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- 1.1: DeotPDF.exe and deot.exe share one release folder; the MCP SDK in deot needs 10.0.x of these, so the app takes the same instead of PDFsharp's 8.0 -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
  </ItemGroup>
</Project>
