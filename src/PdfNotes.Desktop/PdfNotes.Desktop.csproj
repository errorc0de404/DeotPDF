<Project Sdk="Microsoft.NET.Sdk">
  <!-- DeotPDF, the desktop app for Windows, macOS and Linux (roadmap P4; the WPF app it replaced was retired in 1.2.1,
       decision 21). Build another system with -p:RuntimeIdentifier=linux-x64 etc.; release packages: tools/package-release.ps1. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>DeotPDF</AssemblyName>
    <RootNamespace>PdfNotes.Desktop</RootNamespace>
    <ApplicationIcon>Assets\DeotPDF.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PdfNotes.ViewModels\PdfNotes.ViewModels.csproj" />
    <ProjectReference Include="..\PdfNotes.Editor\PdfNotes.Editor.csproj" />
    <ProjectReference Include="..\PdfNotes.Pdf\PdfNotes.Pdf.csproj" />
    <ProjectReference Include="..\PdfNotes.Text.Skia\PdfNotes.Text.Skia.csproj" />
    <ProjectReference Include="..\PdfNotes.TextEditor.Avalonia\PdfNotes.TextEditor.Avalonia.csproj" />
    <ProjectReference Include="..\PdfNotes.Render.Skia\PdfNotes.Render.Skia.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The language packs shipped next to the app (D14e: the app folder's Languages, then the settings folder's). -->
    <None Include="Languages\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
