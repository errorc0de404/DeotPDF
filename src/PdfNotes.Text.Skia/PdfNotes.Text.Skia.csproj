  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="3.119.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PdfNotes.Core\PdfNotes.Core.csproj" />
    <ProjectReference Include="..\PdfNotes.Text\PdfNotes.Text.csproj" />
  </ItemGroup>
</Project>
