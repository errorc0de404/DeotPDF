<Project Sdk="Microsoft.NET.Sdk">
  <!-- The SkiaSharp + HarfBuzz text engine of the app and the CLI (roadmap P2). -->
  <PropertyGroup><TargetFramework>net10.0</TargetFramework></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.HarfBuzz" />
    <!-- SkiaSharp brings the Windows and macOS natives; Linux's are separate packages -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PdfNotes.Core\PdfNotes.Core.csproj" />
    <ProjectReference Include="..\PdfNotes.Text\PdfNotes.Text.csproj" />
  </ItemGroup>
</Project>
