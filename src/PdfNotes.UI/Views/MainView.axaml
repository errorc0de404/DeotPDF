<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:canvas="using:PdfNotes.UI.Canvas"
        xmlns:th="using:PdfNotes.UI.Themes"
        xmlns:l="using:PdfNotes.UI.Localization"
        xmlns:vm="using:PdfNotes.ViewModels"
        xmlns:v="using:PdfNotes.UI.Views"
        x:Class="PdfNotes.UI.Views.MainView"
        x:DataType="vm:MainViewModel"
        Background="{DynamicResource Window.Background}" Foreground="{DynamicResource Text.Primary}"
        FontFamily="{DynamicResource Font.Ui}" FontSize="{DynamicResource FontSize.Body}"
        DragDrop.AllowDrop="True">
    <UserControl.Resources>
        <!-- Palette swatches (spec 3.2): a basic color; a user color has 제거 on its right-click (2026-10-13) -->
        <ItemsPanelTemplate x:Key="Row"><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        <DataTemplate x:Key="BasicSwatch" x:DataType="vm:SwatchViewModel">
            <Button Theme="{StaticResource Swatch}" Tag="{Binding Color}" Background="{Binding Color, Converter={x:Static th:Converters.ColorBrush}}"
                    ToolTip.Tip="{Binding Name}" Classes.current="{Binding IsCurrent}" Command="{Binding Pick}" />
        </DataTemplate>
        <DataTemplate x:Key="UserSwatch" x:DataType="vm:SwatchViewModel">
            <Button Theme="{StaticResource Swatch}" Tag="{Binding Color}" Background="{Binding Color, Converter={x:Static th:Converters.ColorBrush}}"
                    ToolTip.Tip="{Binding Name}" Classes.current="{Binding IsCurrent}" Command="{Binding Pick}">
                <Button.ContextMenu>
                    <ContextMenu><MenuItem Header="{l:T color.remove}" Command="{Binding Remove}" /></ContextMenu>
                </Button.ContextMenu>
            </Button>
        </DataTemplate>
    </UserControl.Resources>
    <!-- Roadmap P4 A5: the WPF window's frame (MainWindow.xaml) on Avalonia, with the same names; P5a: a view the desktop window and the Android activity both show. -->
    <DockPanel>
        <!-- Top ribbon (spec 3.2): quick commands / tab heads / the tab's commands. Changing the tab keeps the tool. -->
        <Border x:Name="RibbonHost" DockPanel.Dock="Top" Background="{DynamicResource Bar.Background}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
            <StackPanel>
                <DockPanel Margin="{DynamicResource Space.TabRow}">
                    <!-- Settings (spec 18.1): the right end, on every tab -->
                    <Button x:Name="SettingsButton" DockPanel.Dock="Right" Theme="{StaticResource ToolButton}" Command="{Binding SettingsCommand}" ToolTip.Tip="{l:T ribbon.settingsTip}">
                        <th:AppIcon Glyph="Settings" />
                    </Button>
                    <StackPanel Orientation="Horizontal">
                        <!-- Quick commands: open (2026-10-15) · save · undo · redo -->
                        <Button x:Name="QuickOpenButton" Theme="{StaticResource ToolButton}" Command="{Binding OpenCommand}" ToolTip.Tip="{l:T ribbon.openTip}"><th:AppIcon Glyph="Open" /></Button>
                        <Button x:Name="QuickSaveButton" Theme="{StaticResource ToolButton}" Command="{Binding SaveCommand}" ToolTip.Tip="{l:T ribbon.saveTip}"><th:AppIcon Glyph="Save" /></Button>
                        <Button x:Name="UndoButton" Theme="{StaticResource ToolButton}" ToolTip.ShowOnDisabled="True" Command="{Binding UndoCommand}" ToolTip.Tip="{Binding UndoTip}"><th:AppIcon Glyph="Undo" /></Button>
                        <Button x:Name="RedoButton" Theme="{StaticResource ToolButton}" ToolTip.ShowOnDisabled="True" Command="{Binding RedoCommand}" ToolTip.Tip="{Binding RedoTip}"><th:AppIcon Glyph="Redo" /></Button>
                        <Border Classes="sep" />
                        <RadioButton x:Name="FileTabButton" Theme="{StaticResource RibbonTab}" GroupName="RibbonTabs" Content="{l:T tab.file}" Tag="File"
                                     IsChecked="{Binding Ribbon.IsFile, Mode=OneWay}" Command="{Binding Ribbon.ShowCommand}" CommandParameter="File" />
                        <RadioButton x:Name="HomeTabButton" Theme="{StaticResource RibbonTab}" GroupName="RibbonTabs" Content="{l:T tab.write}" Tag="Home"
                                     IsChecked="{Binding Ribbon.IsHome, Mode=OneWay}" Command="{Binding Ribbon.ShowCommand}" CommandParameter="Home" />
                        <RadioButton x:Name="PageTabButton" Theme="{StaticResource RibbonTab}" GroupName="RibbonTabs" Content="{l:T tab.page}" Tag="Page"
                                     IsChecked="{Binding Ribbon.IsPage, Mode=OneWay}" Command="{Binding Ribbon.ShowCommand}" CommandParameter="Page" />
                        <RadioButton x:Name="ViewTabButton" Theme="{StaticResource RibbonTab}" GroupName="RibbonTabs" Content="{l:T tab.view}" Tag="View"
                                     IsChecked="{Binding Ribbon.IsView, Mode=OneWay}" Command="{Binding Ribbon.ShowCommand}" CommandParameter="View" />
                    </StackPanel>
                </DockPanel>

                <Panel Margin="{DynamicResource Space.Ribbon}">
                    <!-- 파일 -->
                    <WrapPanel x:Name="FileTab" IsVisible="{Binding Ribbon.IsFile}">
                        <HeaderedContentControl Theme="{StaticResource RibbonGroup}" Header="{l:T group.document}">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="NewButton" Theme="{StaticResource ToolButton}" Command="{Binding NewCommand}" ToolTip.Tip="{l:T ribbon.newTip}"><th:IconLabel Glyph="New" Text="{l:T ribbon.new}" /></Button>
                                <Button x:Name="OpenButton" Theme="{StaticResource ToolButton}" Command="{Binding OpenCommand}" ToolTip.Tip="{l:T ribbon.openTip}"><th:IconLabel Glyph="Open" Text="{l:T ribbon.open}" /></Button>
                                <!-- Recent documents (spec 24.1): the list is the ▾ menu -->
                                <Button x:Name="RecentButton" Theme="{StaticResource ToolButton}" Command="{Binding RecentCommand}" ToolTip.Tip="{l:T ribbon.recent}">
                                    <StackPanel Orientation="Horizontal">
                                        <th:IconLabel Glyph="Recent" Text="{l:T ribbon.recent}" />
                                        <th:AppIcon Glyph="ChevronDown" Size="10" Margin="4,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <!-- Merge PDFs (D13j): several PDFs → a new document -->
                                <Button x:Name="MergePdfsButton" Theme="{StaticResource ToolButton}" Command="{Binding MergeCommand}" ToolTip.Tip="{l:T ribbon.mergeTip}"><th:IconLabel Glyph="Merge" Text="{l:T ribbon.merge}" /></Button>
                            </StackPanel>
                        </HeaderedContentControl>
                        <Border Classes="sep" />
                        <HeaderedContentControl Theme="{StaticResource RibbonGroup}" Header="{l:T group.save}">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="SaveButton" Theme="{StaticResource ToolButton}" Command="{Binding SaveCommand}" ToolTip.Tip="{l:T ribbon.saveTip}"><th:IconLabel Glyph="Save" Text="{l:T ribbon.save}" /></Button>
                                <Button x:Name="SaveAsButton" Theme="{StaticResource ToolButton}" Command="{Binding SaveAsCommand}" ToolTip.Tip="{l:T ribbon.saveAsTip}"><th:IconLabel Glyph="SaveAs" Text="{l:T ribbon.saveAs}" /></Button>
                                <Button x:Name="ExportFlattenedButton" Theme="{StaticResource ToolButton}" Command="{Binding ExportFlattenedCommand}" ToolTip.Tip="{l:T file.exportFlattenedTitle}"><th:IconLabel Glyph="ExportFlattened" Text="{l:T ribbon.exportFlattened}" /></Button>
                                <Button x:Name="ExportPagesFileButton" Theme="{StaticResource ToolButton}" Command="{Binding ExportPagesCommand}" ToolTip.Tip="{l:T ribbon.exportTip}"><th:IconLabel Glyph="ExportPages" Text="{l:T ribbon.export}" /></Button>
                            </StackPanel>
                        </HeaderedContentControl>
                        <Border Classes="sep" />
                        <HeaderedContentControl Theme="{StaticResource RibbonGroup}" Header="{l:T group.app}">
                            <Button x:Name="SettingsRibbonButton" Theme="{StaticResource ToolButton}" Command="{Binding SettingsCommand}" ToolTip.Tip="{l:T ribbon.settingsTip}"><th:IconLabel Glyph="Settings" Text="{l:T ribbon.settings}" /></Button>
                        </HeaderedContentControl>
                    </WrapPanel>

                    <!-- 필기 (the tab named Home): the tools by function; the buttons follow the tool bar's view model (R4d) -->
                    <WrapPanel x:Name="HomeTab" IsVisible="{Binding Ribbon.IsHome}">
                        <HeaderedContentControl Theme="{StaticResource RibbonGroup}" Header="{l:T group.select}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="SelectToolButton" Theme="{StaticResource ToolButton}" GroupName="Tools" ToolTip.Tip="{l:T tool.select}" Tag="Select"
                                             IsChecked="{Binding ToolBar.Select.IsChecked, Mode=OneWay}" Command="{Binding ToolBar.Select.Command}" Classes.return="{Binding ToolBar.Select.IsReturn}"><th:IconLabel Glyph="Select" Text="{l:T tool.select}" /></RadioButton>
                                <RadioButton x:Name="LassoToolButton" Theme="{StaticResource ToolButton}" GroupName="Tools" ToolTip.Tip="{l:T tool.lasso}" Tag="Lasso"
                                             IsChecked="{Binding ToolBar.Lasso.IsChecked, Mode=OneWay}" Command="{Binding ToolBar.Lasso.Command}" Classes.return="{Binding ToolBar.Lasso.IsReturn}"><th:IconLabel Glyph="Lasso" Text="{l:T tool.lasso}" /></RadioButton>
                            </StackPanel>
                        </HeaderedContentControl>
                        <Border Classes="sep" />
                        <HeaderedContentControl Theme="{StaticResource RibbonGroup}" Header="{l:T group.draw}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="PenToolButton" Theme="{StaticResource ToolButton}" GroupName="Tools" ToolTip.Tip="{l:T ribbon.pen}" Tag="Pen"
                                             IsChecked="{Binding ToolBar.Pen.IsChecked, Mode=OneWay}" Command="{Binding ToolBar.Pen.Command}" Classes.return="{Binding ToolBar.Pen.IsReturn}"><th:IconLabel Glyph="Pen" Text="{l:T ribbon.pen}" /></RadioButton>
                                <RadioButton x:Name="HighlighterToolButton" Theme="{StaticResource ToolButton}" GroupName="Tools" ToolTip.Tip="{l:T ribbon.highlighter}" Tag="FreeHighlight"
                                             IsChecked="{Binding ToolBar.Highlighter.IsChecked, Mode=OneWay}" Command="{Binding ToolBar.Highlighter.Command}" Classes.return="{Binding ToolBar.Highlighter.IsReturn}"><th:IconLabel Glyph="Highlighter" Text="{l:T ribbon.highlighter}" /></RadioButton>
                                <RadioButton x:Name="EraserToolButton" Theme="{StaticResource ToolButton}" GroupName="Tools" ToolTip.Tip="{l:T ribbon.eraser}" Tag="Eraser"
                                             IsChecked="{Binding ToolBar.Eraser.IsChecked, Mode=OneWay}" Command="{Binding ToolBar.Eraser.Command}" Classes.return="{Binding ToolBar.Eraser.IsReturn}"><th:IconLabel Glyph="Eraser" Text="{l:T ribbon.eraser}" /></RadioButton>
                            </StackPanel>
                        </HeaderedContentControl>
                        <Border Classes="sep" />
                        <HeaderedContentControl Theme="{StaticResource RibbonGroup}" Header="{l:T group.insert}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="TextToolButton" Theme="{StaticResource ToolButton}" GroupName="Tools" ToolTip.Tip="{l:T ribbon.text}" Tag="Text"
                                             IsChecked="{Binding ToolBar.Text.IsChecked, Mode=OneWay}" Command="{Binding ToolBar.Text.Command}" Classes.return="{Binding ToolBar.Text.IsReturn}"><th:IconLabel Glyph="Text" Text="{l:T ribbon.text}" /></RadioButton>
                                <!-- Shapes (spec 8): the button is the last shape group tool, ▾ is the list -->
                                <RadioButton x:Name="ShapeToolButton" Theme="{StaticResource ToolButton}" GroupName="Tools" ToolTip.Tip="{l:T ribbon.shape}" Tag="ShapeGroup" Padding="6,5,2,5"
                                             IsChecked="{Binding ToolBar.Shape.IsChecked, Mode=OneWay}" Command="{Binding ToolBar.Shape.Command}" Classes.return="{Binding ToolBar.Shape.IsReturn}">
                                    <th:IconLabel x:Name="ShapeToolLabel" Text="{l:T ribbon.shape}" Outline="{Binding ToolBar.ShapeIcon, Converter={x:Static th:Converters.ShapeOutline}}" />
                                </RadioButton>
                                <Button x:Name="ShapeMenuButton" Theme="{StaticResource ToolButton}" Padding="2,5" ToolTip.Tip="{l:T ribbon.shapeMenuTip}" Click="ShapeMenuClick"><th:AppIcon Glyph="ChevronDown" Size="10" /></Button>
                                <RadioButton x:Name="NoteToolButton" Theme="{StaticResource ToolButton}" GroupName="Tools" ToolTip.Tip="{l:T ribbon.note}" Tag="Note"
                                             IsChecked="{Binding ToolBar.Note.IsChecked, Mode=OneWay}" Command="{Binding ToolBar.Note.Command}" Classes.return="{Binding ToolBar.Note.IsReturn}"><th:IconLabel Glyph="Note" Text="{l:T ribbon.note}" /></RadioButton>
                                <Button x:Name="InsertImageButton" Theme="{StaticResource ToolButton}" ToolTip.Tip="{l:T image.insertTitle}" Command="{Binding InsertImageCommand}"><th:IconLabel Glyph="Image" Text="{l:T ribbon.image}" /></Button>
                            </StackPanel>
                        </HeaderedContentControl>
                        <!-- Other apps' annotations (spec 14.6, D14g): only in documents that have some -->
                        <Border x:Name="ForeignSeparator" Classes="sep" IsVisible="{Binding Foreign.IsShown}" />
                        <Button x:Name="ForeignEditButton" Theme="{StaticResource ToolButton}" ToolTip.Tip="{l:T foreign.convertTip}" IsVisible="{Binding Foreign.IsShown}" Command="{Binding Foreign.ConvertCommand}">
                            <th:IconLabel Glyph="Edit" Text="{l:T foreign.convert}" />
                        </Button>
                    </WrapPanel>

                    <!-- 페이지: the page commands (the same as the page list's context menu; R4e) -->
                    <WrapPanel x:Name="PageTab" IsVisible="{Binding Ribbon.IsPage}">
                        <HeaderedContentControl Theme="{StaticResource RibbonGroup}" Header="{l:T group.newPage}">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="InsertPageButton" Theme="{StaticResource ToolButton}" ToolTip.Tip="{l:T ribbon.insertPageTip}" Padding="6,5,2,5" Command="{Binding Pages.InsertBlankCommand}"><th:IconLabel Glyph="New" Text="{l:T import.insert}" /></Button>
                                <Button x:Name="InsertPageMenuButton" Theme="{StaticResource ToolButton}" Padding="2,5" ToolTip.Tip="{l:T ribbon.insertMenuTip}" Click="InsertMenuClick"><th:AppIcon Glyph="ChevronDown" Size="10" /></Button>
                            </StackPanel>
                        </HeaderedContentControl>
                        <Border Classes="sep" />
                        <HeaderedContentControl Theme="{StaticResource RibbonGroup}" Header="{l:T group.copy}">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CopyPageButton" Theme="{StaticResource ToolButton}" ToolTip.Tip="{l:T page.copyWithNotes}" Command="{Binding Pages.CopyCommand}"><th:IconLabel Glyph="Copy" Text="{l:T command.copy}" /></Button>
                                <Button x:Name="CopyPageOnlyButton" Theme="{StaticResource ToolButton}" ToolTip.Tip="{l:T page.copyPageOnly}" Command="{Binding Pages.CopyPageOnlyCommand}"><TextBlock Text="{l:T page.copyPageOnly}" /></Button>
                                <Button x:Name="PastePageButton" Theme="{StaticResource ToolButton}" ToolTip.Tip="{l:T ribbon.pastePagesTip}" Command="{Binding Pages.PasteCommand}"><th:IconLabel Glyph="Paste" Text="{l:T command.paste}" /></Button>
                                <!-- Export pages (spec 11.10, D13j) -->
                                <Button x:Name="ExportPagesButton" Theme="{StaticResource ToolButton}" ToolTip.Tip="{l:T ribbon.exportPagesTip}" Command="{Binding Pages.ExportCommand}"><th:IconLabel Glyph="ExportFlattened" Text="{l:T export.ok}" /></Button>
                            </StackPanel>
                        </HeaderedContentControl>
                        <Border Classes="sep" />
                        <HeaderedContentControl Theme="{StaticResource RibbonGroup}" Header="{l:T group.organize}">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="DeletePageButton" Theme="{StaticResource ToolButton}" ToolTip.Tip="{l:T command.delete}" Command="{Binding Pages.DeleteCommand}"><th:IconLabel Glyph="Delete" Text="{l:T command.delete}" /></Button>
                                <!-- Delete this page's notes (spec 11.11, D13j) -->
                                <Button x:Name="ClearPageNotesButton" Theme="{StaticResource ToolButton}" ToolTip.Tip="{l:T page.clearNotes}" Command="{Binding Pages.ClearNotesCommand}"><th:IconLabel Glyph="ClearNotes" Text="{l:T ribbon.clearNotes}" /></Button>
                                <Button x:Name="RotateLeftButton" Theme="{StaticResource ToolButton}" ToolTip.Tip="{l:T page.rotateLeft}" Command="{Binding Pages.RotateLeftCommand}"><th:AppIcon Glyph="RotateLeft" /></Button>
                                <Button x:Name="RotateRightButton" Theme="{StaticResource ToolButton}" ToolTip.Tip="{l:T page.rotateRight}" Command="{Binding Pages.RotateRightCommand}"><th:AppIcon Glyph="RotateRight" /></Button>
                            </StackPanel>
                        </HeaderedContentControl>
                        <Border Classes="sep" />
                        <HeaderedContentControl Theme="{StaticResource RibbonGroup}" Header="{l:T group.size}">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ShrinkPageButton" Theme="{StaticResource ToolButton}" ToolTip.Tip="{l:T page.shrinkContent}" Command="{Binding Pages.ShrinkCommand}"><th:IconLabel Glyph="Shrink" Text="{l:T page.shrinkContent}" /></Button>
                                <Button x:Name="ResizePageButton" Theme="{StaticResource ToolButton}" ToolTip.Tip="{l:T page.resize}" Command="{Binding Pages.ResizeCommand}"><th:IconLabel Glyph="Resize" Text="{l:T page.resize}" /></Button>
                            </StackPanel>
                        </HeaderedContentControl>
                        <Border Classes="sep" />
                        <HeaderedContentControl Theme="{StaticResource RibbonGroup}" Header="{l:T group.show}">
                            <ToggleButton x:Name="PagePanelButton" Theme="{StaticResource ToolButton}" ToolTip.Tip="{l:T page.list}"
                                          IsChecked="{Binding Pages.PanelVisible, Mode=OneWay}" Command="{Binding Pages.TogglePanelCommand}"><th:IconLabel Glyph="PageList" Text="{l:T page.list}" /></ToggleButton>
                        </HeaderedContentControl>
                    </WrapPanel>

                    <!-- 보기: zoom, fit, view mode, hide notes, search -->
                    <WrapPanel x:Name="ViewTab" IsVisible="{Binding Ribbon.IsView}">
                        <HeaderedContentControl Theme="{StaticResource RibbonGroup}" Header="{l:T group.zoom}">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ZoomOutButton" Theme="{StaticResource ToolButton}" Command="{Binding Navigation.ZoomOutCommand}" ToolTip.Tip="{l:T view.zoomOut}"><th:AppIcon Glyph="ZoomOut" /></Button>
                                <ComboBox x:Name="ZoomBox" Classes="bar" Width="84" IsEditable="True" Margin="2,0" ToolTip.Tip="{l:T view.zoom}"
                                          ItemsSource="{Binding Navigation.ZoomPresets}" Text="{Binding Navigation.ZoomInput, Mode=TwoWay}" />
                                <Button x:Name="ZoomInButton" Theme="{StaticResource ToolButton}" Command="{Binding Navigation.ZoomInCommand}" ToolTip.Tip="{l:T view.zoomIn}"><th:AppIcon Glyph="ZoomIn" /></Button>
                            </StackPanel>
                        </HeaderedContentControl>
                        <Border Classes="sep" />
                        <HeaderedContentControl Theme="{StaticResource RibbonGroup}" Header="{l:T group.fit}">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="FitWidthButton" Theme="{StaticResource ToolButton}" Command="{Binding Navigation.FitWidthCommand}" ToolTip.Tip="{l:T view.fitWidth}"><th:IconLabel Glyph="FitWidth" Text="{l:T view.fitWidth}" /></Button>
                                <Button x:Name="FitPageButton" Theme="{StaticResource ToolButton}" Command="{Binding Navigation.FitPageCommand}" ToolTip.Tip="{l:T view.fitPage}"><th:IconLabel Glyph="FitPage" Text="{l:T view.fitPage}" /></Button>
                            </StackPanel>
                        </HeaderedContentControl>
                        <Border Classes="sep" />
                        <HeaderedContentControl Theme="{StaticResource RibbonGroup}" Header="{l:T group.viewMode}">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="ContinuousButton" Theme="{StaticResource ToolButton}" IsChecked="{Binding Navigation.IsContinuous, Mode=OneWay}" Command="{Binding Navigation.ContinuousCommand}" ToolTip.Tip="{l:T view.continuousTip}"><th:IconLabel Glyph="Continuous" Text="{l:T view.continuous}" /></ToggleButton>
                                <ToggleButton x:Name="SinglePageButton" Theme="{StaticResource ToolButton}" IsChecked="{Binding Navigation.IsSinglePage, Mode=OneWay}" Command="{Binding Navigation.SinglePageCommand}" ToolTip.Tip="{l:T view.singlePage}"><th:IconLabel Glyph="SinglePage" Text="{l:T view.singlePage}" /></ToggleButton>
                            </StackPanel>
                        </HeaderedContentControl>
                        <Border Classes="sep" />
                        <HeaderedContentControl Theme="{StaticResource RibbonGroup}" Header="{l:T group.show}">
                            <ToggleButton x:Name="HideNotesButton" Theme="{StaticResource ToolButton}" IsChecked="{Binding Display.NotesHidden, Mode=OneWay}" Command="{Binding HideNotesCommand}" ToolTip.Tip="{l:T view.hideNotes}"><th:IconLabel Glyph="Hide" Text="{l:T view.hideNotes}" /></ToggleButton>
                        </HeaderedContentControl>
                        <Border Classes="sep" />
                        <HeaderedContentControl Theme="{StaticResource RibbonGroup}" Header="{l:T group.find}">
                            <Button x:Name="SearchButton" Theme="{StaticResource ToolButton}" Command="{Binding SearchCommand}" ToolTip.Tip="{l:T view.searchTip}"><th:IconLabel Glyph="Search" Text="{l:T view.search}" /></Button>
                        </HeaderedContentControl>
                    </WrapPanel>
                </Panel>
            </StackPanel>
        </Border>

        <!-- The context settings row: left one of the three bars, right the pen favorites — on every tab (spec 24.7).
             Everything here is bound to the tool styles, the text bar and the favorites (R4d). -->
        <Border x:Name="SubBarRow" DockPanel.Dock="Top" Background="{DynamicResource SubBar.Background}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel x:Name="FavoritesGroup" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,2,0" Height="{DynamicResource Height.SubBarRow}"
                            IsVisible="{Binding Display.FavoritesShown}">
                    <Border x:Name="FavoritesSeparator" Classes="sep" />
                    <ItemsControl x:Name="FavoritesPanel" VerticalAlignment="Center" ItemsSource="{Binding Favorites.Items}" ItemsPanel="{StaticResource Row}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FavoriteItemViewModel">
                                <Button Theme="{StaticResource ToolButton}" Padding="2" ToolTip.Tip="{Binding Tip}" Command="{Binding Apply}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{l:T favorites.replace}" Command="{Binding Store}" />
                                            <MenuItem Header="{l:T favorites.clear}" Command="{Binding Clear}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <th:FavoriteMark Favorite="{Binding Slot}" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Panel>
                    <!-- Style bar (D13c): [palette | width | transparency | kind options]; the three bars have one height -->
                    <Border x:Name="StyleBar" Padding="{DynamicResource Space.SubBar}" IsVisible="{Binding ToolStyles.StyleBarShown}"
                            IsEnabled="{Binding ToolStyles.StyleBarEnabled}" Opacity="{Binding ToolStyles.StyleBarOpacity}">
                        <WrapPanel x:Name="StylePanel" Orientation="Horizontal" ItemHeight="{DynamicResource Height.SubBarRow}">
                            <!-- Shapes: fill/border target and the border dash, before the palette (like the text bar) -->
                            <StackPanel x:Name="ShapeOptionsPanel" Orientation="Horizontal" VerticalAlignment="Center" IsVisible="{Binding ToolStyles.ShapeOptionsShown}">
                                <RadioButton x:Name="ShapeFillButton" Theme="{StaticResource ToolButton}" GroupName="ShapeTarget" Content="{l:T shape.fill}"
                                             IsChecked="{Binding ToolStyles.ShapeFillTarget, Mode=OneWay}" Command="{Binding ToolStyles.ShapeTargetCommand}" CommandParameter="Fill" />
                                <RadioButton x:Name="ShapeBorderButton" Theme="{StaticResource ToolButton}" GroupName="ShapeTarget" Content="{l:T shape.border}"
                                             IsChecked="{Binding ToolStyles.ShapeBorderTarget, Mode=OneWay}" Command="{Binding ToolStyles.ShapeTargetCommand}" CommandParameter="Border" />
                                <ComboBox x:Name="ShapeBorderBox" Classes="bar" Width="92" Margin="8,0,0,0" ToolTip.Tip="{l:T shape.borderStyle}"
                                          ItemsSource="{Binding ToolStyles.BorderNames}" SelectedIndex="{Binding ToolStyles.ShapeBorderIndex, Mode=TwoWay}" />
                                <Border Classes="sep" />
                            </StackPanel>
                            <!-- The highlighter's kind (spec 9.1): highlight / underline / strikeout -->
                            <StackPanel x:Name="MarkKindPanel" Classes="field" IsVisible="{Binding ToolStyles.MarkKindShown}">
                                <RadioButton x:Name="MarkHighlightButton" Theme="{StaticResource ToolButton}" GroupName="MarkKind" Content="{l:T highlighter.kindHighlight}" Padding="6,3"
                                             IsChecked="{Binding ToolStyles.IsMarkHighlight, Mode=OneWay}" Command="{Binding ToolStyles.MarkKindCommand}" CommandParameter="Highlight" />
                                <RadioButton x:Name="MarkUnderlineButton" Theme="{StaticResource ToolButton}" GroupName="MarkKind" Content="{l:T markup.underline}" Padding="6,3"
                                             IsChecked="{Binding ToolStyles.IsMarkUnderline, Mode=OneWay}" Command="{Binding ToolStyles.MarkKindCommand}" CommandParameter="Underline" />
                                <RadioButton x:Name="MarkStrikeOutButton" Theme="{StaticResource ToolButton}" GroupName="MarkKind" Content="{l:T text.strikeOut}" Padding="6,3"
                                             IsChecked="{Binding ToolStyles.IsMarkStrikeOut, Mode=OneWay}" Command="{Binding ToolStyles.MarkKindCommand}" CommandParameter="StrikeOut" />
                                <Border Classes="sep" />
                            </StackPanel>
                            <!-- Palette: 10 basic colors | user colors · + -->
                            <StackPanel x:Name="PaletteGroup" Classes="field">
                                <ItemsControl x:Name="PalettePanel" VerticalAlignment="Center" ItemsSource="{Binding ToolStyles.BasicSwatches}" ItemTemplate="{StaticResource BasicSwatch}" ItemsPanel="{StaticResource Row}" />
                                <Border Classes="sep" />
                                <ItemsControl x:Name="RecentPanel" VerticalAlignment="Center" ItemsSource="{Binding ToolStyles.UserSwatches}" ItemTemplate="{StaticResource UserSwatch}" ItemsPanel="{StaticResource Row}" />
                                <v:CustomColorButton x:Name="CustomColor" StartColor="{Binding ToolStyles.CustomColorStart}" CanAdd="{Binding ToolStyles.CanAddColor}" Command="{Binding ToolStyles.PickColorCommand}" />
                            </StackPanel>
                            <Border Classes="sep" />
                            <StackPanel Classes="field">
                                <TextBlock Classes="label" Text="{l:T style.width}" />
                                <Slider x:Name="WidthSlider" Classes="bar" Width="110" IsSnapToTickEnabled="False" IsEnabled="{Binding ToolStyles.WidthEnabled}"
                                        Minimum="{Binding ToolStyles.WidthMinimum}" Maximum="{Binding ToolStyles.WidthMaximum}" Value="{Binding ToolStyles.WidthSlider, Mode=TwoWay}" />
                                <TextBox x:Name="WidthBox" Classes="bar" Width="44" Margin="6,0,0,0" TextAlignment="Right" IsEnabled="{Binding ToolStyles.WidthEnabled}"
                                         Text="{Binding ToolStyles.WidthField.Text, Mode=TwoWay}" />
                                <TextBlock Classes="unit" Text="pt" />
                                <!-- 자동 glyph highlight height, next to pt (spec 9.1) -->
                                <ToggleButton x:Name="HighlightAutoButton" Theme="{StaticResource ToolButton}" Content="{l:T common.auto}" Padding="6,3" Margin="6,0,0,0" ToolTip.Tip="{l:T style.autoTip}"
                                              IsVisible="{Binding ToolStyles.HighlightAutoShown}" IsChecked="{Binding ToolStyles.HighlightAutoOn, Mode=OneWay}" Command="{Binding ToolStyles.HighlightAutoCommand}" />
                            </StackPanel>
                            <Border Classes="sep" />
                            <StackPanel Classes="field">
                                <TextBlock Classes="label" Text="{l:T style.transparency}" />
                                <Slider x:Name="TransparencySlider" Classes="bar" Width="110" Minimum="0" Maximum="100" IsEnabled="{Binding ToolStyles.TransparencyEnabled}"
                                        Value="{Binding ToolStyles.TransparencySlider, Mode=TwoWay}" />
                                <TextBox x:Name="TransparencyBox" Classes="bar" Width="44" Margin="6,0,0,0" TextAlignment="Right" IsEnabled="{Binding ToolStyles.TransparencyEnabled}"
                                         Text="{Binding ToolStyles.TransparencyField.Text, Mode=TwoWay}" />
                                <TextBlock Classes="unit" Text="%" />
                                <!-- The highlighter's 글자에 맞추기 (spec 9.1) -->
                                <ToggleButton x:Name="HighlighterSnapButton" Theme="{StaticResource ToolButton}" Content="{l:T highlighter.snap}" Padding="6,3" Margin="8,0,0,0"
                                              IsVisible="{Binding ToolStyles.HighlighterSnapShown}" IsEnabled="{Binding ToolStyles.HighlighterSnapEnabled}"
                                              IsChecked="{Binding ToolStyles.HighlighterSnapOn, Mode=OneWay}" Command="{Binding ToolStyles.HighlighterSnapCommand}" />
                            </StackPanel>
                            <!-- Kind options: lines -->
                            <StackPanel x:Name="LineOptionsPanel" Orientation="Horizontal" VerticalAlignment="Center" IsVisible="{Binding ToolStyles.LineOptionsShown}">
                                <Border Classes="sep" />
                                <ComboBox x:Name="DashBox" Classes="bar" Width="82" ToolTip.Tip="{l:T line.dashStyle}"
                                          ItemsSource="{Binding ToolStyles.DashNames}" SelectedIndex="{Binding ToolStyles.DashIndex, Mode=TwoWay}" />
                                <ToggleButton x:Name="StartArrowButton" Theme="{StaticResource ToolButton}" Width="30" Margin="4,0,0,0" ToolTip.Tip="{l:T line.startArrow}"
                                              IsChecked="{Binding ToolStyles.StartArrowOn, Mode=OneWay}" Command="{Binding ToolStyles.StartArrowCommand}"><th:AppIcon Glyph="ArrowLeft" /></ToggleButton>
                                <ToggleButton x:Name="EndArrowButton" Theme="{StaticResource ToolButton}" Width="30" Margin="4,0,0,0" ToolTip.Tip="{l:T line.endArrow}"
                                              IsChecked="{Binding ToolStyles.EndArrowOn, Mode=OneWay}" Command="{Binding ToolStyles.EndArrowCommand}"><th:AppIcon Glyph="ArrowRight" /></ToggleButton>
                                <ComboBox x:Name="LineShapeBox" Classes="bar" Width="104" Margin="8,0,0,0" ToolTip.Tip="{l:T line.controls}" IsVisible="{Binding ToolStyles.LineShapeShown}"
                                          ItemsSource="{Binding ToolStyles.LineShapes}" SelectedIndex="{Binding ToolStyles.LineShapeIndex, Mode=TwoWay}" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <!-- Eraser settings (spec 7.3–7.4): stroke/area, size (pt) -->
                    <Border x:Name="EraserBorder" Padding="{DynamicResource Space.SubBar}" IsVisible="{Binding ToolStyles.EraserBarShown}">
                        <WrapPanel Orientation="Horizontal" ItemHeight="{DynamicResource Height.SubBarRow}">
                            <RadioButton x:Name="StrokeEraserButton" Theme="{StaticResource ToolButton}" GroupName="EraserMode" Content="{l:T eraser.stroke}" ToolTip.Tip="{l:T tool.strokeEraser}" Tag="StrokeEraser"
                                         IsChecked="{Binding ToolBar.StrokeEraser.IsChecked, Mode=OneWay}" Command="{Binding ToolBar.StrokeEraser.Command}" />
                            <RadioButton x:Name="AreaEraserButton" Theme="{StaticResource ToolButton}" GroupName="EraserMode" Content="{l:T eraser.area}" ToolTip.Tip="{l:T tool.areaEraser}" Tag="AreaEraser"
                                         IsChecked="{Binding ToolBar.AreaEraser.IsChecked, Mode=OneWay}" Command="{Binding ToolBar.AreaEraser.Command}" />
                            <Border Classes="sep" />
                            <StackPanel Classes="field">
                                <TextBlock Classes="label" Text="{l:T transform.size}" />
                                <Slider x:Name="EraserSizeSlider" Classes="bar" Width="110" Minimum="2" Maximum="100" Value="{Binding ToolStyles.EraserSlider, Mode=TwoWay}" />
                                <TextBox x:Name="EraserSizeBox" Classes="bar" Width="44" Margin="6,0,0,0" TextAlignment="Right" Text="{Binding ToolStyles.EraserField.Text, Mode=TwoWay}" />
                                <TextBlock Classes="unit" Text="pt" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <!-- Text bar (spec 3.2, 6): [target | palette, user colors, + | transparency | font and size | B I U S highlight | alignment, saved styles] -->
                    <Border x:Name="TextStyleBorder" Padding="{DynamicResource Space.SubBar}" IsVisible="{Binding TextStyle.TextBarShown}" IsEnabled="{Binding TextStyle.TextBarEnabled}">
                        <WrapPanel x:Name="TextStylePanel" Orientation="Horizontal" ItemHeight="{DynamicResource Height.SubBarRow}">
                            <StackPanel Classes="field" Margin="0,0,6,0">
                                <RadioButton x:Name="TextTargetText" Theme="{StaticResource ToolButton}" GroupName="TextColorTarget" Content="{l:T text.targetText}"
                                             IsChecked="{Binding TextStyle.IsTargetText, Mode=OneWay}" Command="{Binding TextStyle.TargetCommand}" CommandParameter="Text" />
                                <RadioButton x:Name="TextTargetFill" Theme="{StaticResource ToolButton}" GroupName="TextColorTarget" Content="{l:T text.targetFill}"
                                             IsChecked="{Binding TextStyle.IsTargetFill, Mode=OneWay}" Command="{Binding TextStyle.TargetCommand}" CommandParameter="Fill" />
                                <RadioButton x:Name="TextTargetBorder" Theme="{StaticResource ToolButton}" GroupName="TextColorTarget" Content="{l:T text.targetBorder}"
                                             IsChecked="{Binding TextStyle.IsTargetBorder, Mode=OneWay}" Command="{Binding TextStyle.TargetCommand}" CommandParameter="Border" />
                            </StackPanel>
                            <StackPanel Classes="field" Margin="0,0,6,0">
                                <ItemsControl x:Name="TextPalettePanel" VerticalAlignment="Center" ItemsSource="{Binding TextStyle.BasicSwatches}" ItemTemplate="{StaticResource BasicSwatch}" ItemsPanel="{StaticResource Row}" />
                                <Border Classes="sep" />
                                <ItemsControl x:Name="TextRecentPanel" VerticalAlignment="Center" ItemsSource="{Binding TextStyle.UserSwatches}" ItemTemplate="{StaticResource UserSwatch}" ItemsPanel="{StaticResource Row}" />
                                <v:CustomColorButton x:Name="TextCustomColor" StartColor="{Binding TextStyle.CustomColorStart}" CanAdd="{Binding TextStyle.CanAddColor}" Command="{Binding TextStyle.PickColorCommand}" />
                            </StackPanel>
                            <Border Classes="sep" />
                            <StackPanel Classes="field" Margin="0,0,6,0">
                                <TextBlock Classes="label" Text="{l:T style.transparency}" />
                                <TextBox x:Name="TextAlphaBox" Classes="bar" Width="40" ToolTip.Tip="{l:T style.transparency}" IsEnabled="{Binding TextStyle.TransparencyEnabled}"
                                         Text="{Binding TextStyle.TransparencyField.Text, Mode=TwoWay}" />
                                <TextBlock Classes="unit" Text="%" />
                            </StackPanel>
                            <Border Classes="sep" />
                            <StackPanel Classes="field" Margin="0,0,6,0">
                                <ComboBox x:Name="TextFontBox" Classes="bar" Width="124" IsEditable="True" Margin="0,0,6,0"
                                          ItemsSource="{Binding TextStyle.FontFamilies}" Text="{Binding TextStyle.FontField.Text, Mode=TwoWay}" />
                                <TextBox x:Name="TextSizeBox" Classes="bar" Width="42" ToolTip.Tip="{l:T text.size}" Text="{Binding TextStyle.SizeField.Text, Mode=TwoWay}" />
                                <TextBlock Classes="unit" Text="pt" />
                            </StackPanel>
                            <Border Classes="sep" />
                            <StackPanel Classes="field" Margin="0,0,6,0">
                                <ToggleButton x:Name="TextBButton" Theme="{StaticResource ToolButton}" Width="27" ToolTip.Tip="{l:T text.bold}"
                                              IsChecked="{Binding TextStyle.IsBold, Mode=OneWay}" Command="{Binding TextStyle.FlagCommand}" CommandParameter="B"><TextBlock Text="B" FontWeight="Bold" /></ToggleButton>
                                <ToggleButton x:Name="TextIButton" Theme="{StaticResource ToolButton}" Width="27" ToolTip.Tip="{l:T text.italic}"
                                              IsChecked="{Binding TextStyle.IsItalic, Mode=OneWay}" Command="{Binding TextStyle.FlagCommand}" CommandParameter="I"><TextBlock Text="I" FontStyle="Italic" /></ToggleButton>
                                <ToggleButton x:Name="TextUButton" Theme="{StaticResource ToolButton}" Width="27" ToolTip.Tip="{l:T text.underline}"
                                              IsChecked="{Binding TextStyle.IsUnderline, Mode=OneWay}" Command="{Binding TextStyle.FlagCommand}" CommandParameter="U"><TextBlock Text="U" TextDecorations="Underline" /></ToggleButton>
                                <ToggleButton x:Name="TextSButton" Theme="{StaticResource ToolButton}" Width="27" ToolTip.Tip="{l:T text.strikeOut}"
                                              IsChecked="{Binding TextStyle.IsStrikeOut, Mode=OneWay}" Command="{Binding TextStyle.FlagCommand}" CommandParameter="S"><TextBlock Text="S" TextDecorations="Strikethrough" /></ToggleButton>
                                <ToggleButton x:Name="TextHighlightButton" Theme="{StaticResource ToolButton}" ToolTip.Tip="{l:T text.highlight}"
                                              IsChecked="{Binding TextStyle.IsHighlighted, Mode=OneWay}" Command="{Binding TextStyle.HighlightCommand}"><th:AppIcon Glyph="Highlighter" /></ToggleButton>
                            </StackPanel>
                            <Border Classes="sep" />
                            <StackPanel Classes="field" Margin="0,0,6,0">
                                <!-- Alignment as icons (the words did not fit at the 1200 DIP one-row width, D13e) -->
                                <ComboBox x:Name="TextAlignmentBox" Classes="bar" Width="54" Margin="0,0,4,0" ToolTip.Tip="{l:T text.alignment}"
                                          ItemsSource="{Binding TextStyle.AlignmentGlyphs}" SelectedIndex="{Binding TextStyle.AlignmentIndex, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="x:String"><th:AppIcon Glyph="{Binding}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button x:Name="TextStylesButton" Theme="{StaticResource ToolButton}" Content="{l:T text.stylesButton}" ToolTip.Tip="{l:T text.savedStyles}" Click="TextStylesClick" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </Panel>
            </DockPanel>
        </Border>

        <!-- Status bar (spec 3.2-7): page number and zoom, a short notice in the middle -->
        <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Background="{DynamicResource Bar.Background}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="8,2">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PreviousPageButton" Theme="{StaticResource ToolButton}" Command="{Binding Navigation.PreviousPageCommand}" ToolTip.Tip="{l:T status.previousPage}"><th:AppIcon Glyph="ChevronLeft" Size="12" /></Button>
                    <TextBox x:Name="PageBox" Classes="bar" Width="44" Height="22" TextAlignment="Center" ToolTip.Tip="{l:T status.pageNumber}" Text="{Binding Navigation.PageInput, Mode=TwoWay}" />
                    <TextBlock x:Name="PageCountText" VerticalAlignment="Center" Margin="6,0" Text="{Binding Navigation.PageCountText}" />
                    <Button x:Name="NextPageButton" Theme="{StaticResource ToolButton}" Command="{Binding Navigation.NextPageCommand}" ToolTip.Tip="{l:T status.nextPage}"><th:AppIcon Glyph="ChevronRight" Size="12" /></Button>
                </StackPanel>
                <!-- A new version (roadmap 1.1): opens the release page -->
                <Button x:Name="UpdateButton" DockPanel.Dock="Right" Theme="{StaticResource ToolButton}" Margin="12,0,0,0" Padding="6,2" Cursor="Hand"
                        ToolTip.Tip="{l:T status.updateTip}" IsVisible="{Binding Update.IsAvailable}" Command="{Binding OpenUpdatePageCommand}">
                    <TextBlock x:Name="UpdateText" Foreground="{DynamicResource Accent}" Text="{Binding Update.AvailableText}" />
                </Button>
                <TextBlock x:Name="NotesHiddenText" DockPanel.Dock="Right" Text="{l:T status.notesHidden}" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource Accent}" IsVisible="{Binding Display.NotesHidden}" />
                <!-- Zoom: a click opens the zoom menu (spec 4.4) -->
                <Button x:Name="ZoomButton" DockPanel.Dock="Right" Theme="{StaticResource ToolButton}" Margin="12,0,0,0" Padding="6,2" Cursor="Hand" ToolTip.Tip="{l:T view.zoom}" Command="{Binding Navigation.ZoomMenuCommand}">
                    <TextBlock x:Name="ZoomText" MinWidth="36" TextAlignment="Right" Foreground="{DynamicResource Text.Secondary}" Text="{Binding Navigation.ZoomText}" />
                </Button>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="16,0" Foreground="{DynamicResource Text.Muted}" TextTrimming="CharacterEllipsis" Text="{Binding Status}" />
            </DockPanel>
        </Border>

        <!-- Page panel (spec 3.2-5, 11): shown by default; thumbnails, several selected, dragging reorders. Bound to the pages view model (R4e). -->
        <Border x:Name="PagePanel" DockPanel.Dock="Left" Width="176" Background="{DynamicResource Panel.Background}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0"
                IsVisible="{Binding Pages.PanelVisible}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="8,4,4,2">
                    <ToggleButton x:Name="MultiSelectButton" DockPanel.Dock="Right" Theme="{StaticResource ToolButton}" Padding="5,2" ToolTip.Tip="{l:T panel.multiSelect}"
                                  IsChecked="{Binding Pages.MultiSelect, Mode=TwoWay}">
                        <th:AppIcon Glyph="MultiSelect" Size="14" />
                    </ToggleButton>
                    <!-- Outline (spec 24.4): off by default, disabled for a PDF without one -->
                    <ToggleButton x:Name="OutlineButton" DockPanel.Dock="Right" Theme="{StaticResource ToolButton}" Padding="5,2" ToolTip.Tip="{l:T panel.outline}"
                                  IsChecked="{Binding Outline.IsVisible, Mode=OneWay}" Command="{Binding Outline.ToggleCommand}">
                        <th:AppIcon Glyph="Outline" Size="14" />
                    </ToggleButton>
                    <TextBlock Text="{l:T export.pages}" VerticalAlignment="Center" Foreground="{DynamicResource Text.Muted}" />
                </DockPanel>
                <Grid x:Name="PagePanelBody" RowDefinitions="0,Auto,*">
                    <TreeView x:Name="OutlineTree" Grid.Row="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              IsVisible="{Binding Outline.IsVisible}" ItemsSource="{Binding Outline.Nodes}" SelectedItem="{Binding Outline.Highlighted, Mode=TwoWay}">
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem" x:DataType="vm:OutlineNodeViewModel">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="ToolTip.Tip" Value="{Binding Title}" />
                            </Style>
                        </TreeView.Styles>
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate x:DataType="vm:OutlineNodeViewModel" ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Opacity="{Binding Opacity}" />
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <GridSplitter x:Name="OutlineSplitter" Grid.Row="1" Height="5" HorizontalAlignment="Stretch" ResizeDirection="Rows" Background="{DynamicResource Divider}"
                                  IsVisible="{Binding Outline.IsVisible}" />
                    <Panel Grid.Row="2" MinHeight="80">
                        <!-- The list and the 빈 페이지 추가 button below it scroll together (the WPF list held the button as its last row) -->
                        <ScrollViewer x:Name="PageScroller" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <ListBox x:Name="PageList" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         ItemsSource="{Binding Pages.Items}" SelectionMode="{Binding Pages.MultiSelect, Converter={x:Static th:Converters.PageSelectionMode}}">
                                    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                    <ListBox.Styles>
                                        <!-- The list's selection is the view model's (R4e) -->
                                        <Style Selector="ListBoxItem" x:DataType="vm:PageItemViewModel">
                                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                        </Style>
                                        <!-- The active page: the accent frame and a bold number -->
                                        <Style Selector="Border.thumb">
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Page.Border}" />
                                        </Style>
                                        <Style Selector="Border.thumb.active">
                                            <Setter Property="BorderThickness" Value="2" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                        </Style>
                                        <Style Selector="TextBlock.thumb">
                                            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
                                        </Style>
                                        <Style Selector="TextBlock.thumb.active">
                                            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PageItemViewModel">
                                            <StackPanel Margin="2,6,2,2">
                                                <Border Name="Frame" Classes="thumb" Classes.active="{Binding IsActive}" HorizontalAlignment="Center" Background="{DynamicResource Paper}">
                                                    <Image Stretch="Fill" Source="{Binding Image}" Width="{Binding ImageWidth}" Height="{Binding ImageHeight}" />
                                                </Border>
                                                <TextBlock Name="Number" Classes="thumb" Classes.active="{Binding IsActive}" HorizontalAlignment="Center" Margin="0,3,0,0"
                                                           FontSize="{DynamicResource FontSize.Caption}" Text="{Binding Number}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button x:Name="AddPageButton" Content="{l:T page.addBlank}" Margin="6,12,6,16" Padding="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Command="{Binding Pages.AddBlankCommand}" />
                            </StackPanel>
                        </ScrollViewer>
                        <Canvas IsHitTestVisible="False">
                            <Border x:Name="PageDropLine" Height="3" Background="{DynamicResource Accent}" Canvas.Left="8" IsVisible="False" CornerRadius="1.5" />
                        </Canvas>
                    </Panel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- The document (spec 3.2-6) -->
        <Panel x:Name="DocumentHost">
            <Border x:Name="CanvasHost" Background="{DynamicResource Canvas.Background}" ClipToBounds="True">
                <Panel>
                    <canvas:DocumentCanvas x:Name="Canvas" />
                    <!-- Controls over the pages: the text box editor (A4); it never covers the scroll bars. -->
                    <Canvas x:Name="TextLayer" Margin="0,0,12,12" ClipToBounds="True" />
                    <!-- The open sticky note card (spec 24.9): kept beside its icon by the window -->
                    <Canvas x:Name="NoteLayer" Margin="0,0,12,12" ClipToBounds="True">
                        <Border x:Name="NoteCard" Width="220" BorderThickness="1,4,1,1" CornerRadius="3" BoxShadow="0 1 8 0 #33000000" Background="{DynamicResource Surface.Background}"
                                IsVisible="{Binding NoteCard.IsOpen}" BorderBrush="{Binding NoteCard.Color, Converter={x:Static th:Converters.ColorBrush}}">
                            <TextBox x:Name="NoteText" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" MinHeight="80" MaxHeight="240" BorderThickness="0"
                                     Background="Transparent" Padding="6,4,6,4" Text="{Binding NoteCard.Text, Mode=TwoWay}" />
                        </Border>
                    </Canvas>
                </Panel>
            </Border>
            <!-- The page list handle (2026-10-14): on the list's right edge; with the list hidden only this shows at the left -->
            <Button x:Name="PagePanelHandle" Theme="{StaticResource PanelHandle}" HorizontalAlignment="Left" VerticalAlignment="Center"
                    ToolTip.Tip="{Binding Pages.HandleTip}" Classes.closed="{Binding !Pages.PanelVisible}" Command="{Binding Pages.TogglePanelCommand}">
                <th:AppIcon x:Name="PagePanelHandleIcon" Glyph="{Binding Pages.HandleGlyph}" Size="10" />
            </Button>
            <!-- Search (spec 12): Ctrl+F, count, previous/next, close -->
            <Border x:Name="SearchBar" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,28,0" Background="{DynamicResource Surface.Background}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Control}" Padding="6,3"
                    BoxShadow="0 1 10 0 #2E000000" IsVisible="{Binding Search.IsOpen}">
                <StackPanel Orientation="Horizontal">
                    <th:AppIcon Glyph="Search" Size="14" TextElement.Foreground="{DynamicResource Text.Muted}" Margin="0,0,4,0" />
                    <TextBox x:Name="SearchBox" Classes="bar" Width="210" BorderThickness="0" Background="Transparent" Text="{Binding Search.Query, Mode=TwoWay}" />
                    <ToggleButton x:Name="SearchCaseButton" Theme="{StaticResource ToolButton}" Padding="5,1" ToolTip.Tip="{l:T search.matchCase}" IsChecked="{Binding Search.MatchCase, Mode=TwoWay}">
                        <TextBlock Text="Aa" FontSize="{DynamicResource FontSize.Caption}" />
                    </ToggleButton>
                    <TextBlock x:Name="SearchCount" MinWidth="52" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Text.Muted}" Margin="6,0,4,0" Text="{Binding Search.CountText}" />
                    <Button x:Name="SearchPreviousButton" Theme="{StaticResource ToolButton}" Padding="5,3" ToolTip.Tip="{l:T search.previous}" Command="{Binding Search.PreviousCommand}"><th:AppIcon Glyph="ChevronUp" Size="12" /></Button>
                    <Button x:Name="SearchNextButton" Theme="{StaticResource ToolButton}" Padding="5,3" ToolTip.Tip="{l:T search.next}" Command="{Binding Search.NextCommand}"><th:AppIcon Glyph="ChevronDown" Size="12" /></Button>
                    <Button x:Name="SearchCloseButton" Theme="{StaticResource ToolButton}" Padding="5,3" ToolTip.Tip="{l:T search.close}" Command="{Binding Search.CloseCommand}"><th:AppIcon Glyph="Close" Size="12" /></Button>
                </StackPanel>
            </Border>
            <!-- Opening a file: a card that does not show for a short open -->
            <Panel x:Name="LoadingOverlay" Background="Transparent" IsVisible="{Binding Loading.IsShown}" IsHitTestVisible="{Binding Loading.BlocksInput}">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource Surface.Background}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Popup}" Padding="18,14" BoxShadow="0 1 14 0 #38000000">
                    <StackPanel Orientation="Horizontal">
                        <ProgressBar IsIndeterminate="True" Width="60" VerticalAlignment="Center" />
                        <TextBlock x:Name="LoadingText" Margin="12,0,0,0" VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text.Primary}"
                                   Text="{Binding Loading.Text}" />
                    </StackPanel>
                </Border>
            </Panel>
        </Panel>
    </DockPanel>
</UserControl>
