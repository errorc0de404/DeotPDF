<Project Sdk="Microsoft.NET.Sdk">
  <!-- deot, the command-line tool for AI agents (cli_plan). Skia text engine and imaging, PDFium for each system: the
       same build on Windows, macOS and Linux (roadmap P2 S7; the WPF build was retired with the WPF app, decision 21). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>deot</AssemblyName>
    <ApplicationIcon>../PdfNotes.Desktop/Assets/DeotPDF.ico</ApplicationIcon>
    <RootNamespace>PdfNotes.Cli</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PdfNotes.Core/PdfNotes.Core.csproj" />
    <ProjectReference Include="../PdfNotes.Editor/PdfNotes.Editor.csproj" />
    <ProjectReference Include="../PdfNotes.Pdf/PdfNotes.Pdf.csproj" />
    <ProjectReference Include="../PdfNotes.Text/PdfNotes.Text.csproj" />
    <ProjectReference Include="../PdfNotes.Text.Skia/PdfNotes.Text.Skia.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.Core" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Schemas/*.json" LogicalName="PdfNotes.Cli.Schemas.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
