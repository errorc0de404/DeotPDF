{
  "input": {
    "type": "object",
    "description": "deot annot delete <pdf> (--id <id[,id…]> | --batch-id <id> | --source-key <key> | --group-key <key>) [-p <page> | --pages <list>] [--include-locked] [--allow-untagged]. --batch-id, --source-key and --group-key find AI annotations only (none found: count 0); -p/--pages narrow them. Locked ones are refused (LOCKED_ANNOTATION) unless --include-locked. Image resources nobody uses any more go too. Only annotations the CLI made (tag author \"ai\") change: others give FORBIDDEN (exit 2) unless --allow-untagged. Errors also: ANNOTATION_NOT_FOUND, LOCKED_ANNOTATION (2), and the write errors (SAME_AS_INPUT, OUTPUT_EXISTS, HASH_MISMATCH, FILE_OPEN_IN_APP).",
    "required": [
      "pdf"
    ],
    "properties": {
      "pdf": {
        "type": "string"
      },
      "id": {
        "type": "string"
      },
      "batchId": {
        "type": "string"
      },
      "sourceKey": {
        "type": "string"
      },
      "groupKey": {
        "type": "string"
      },
      "page": {
        "type": "string"
      },
      "pages": {
        "type": "string"
      },
      "includeLocked": {
        "type": "boolean"
      },
      "allowUntagged": {
        "type": "boolean"
      },
      "out": {
        "type": "string",
        "description": "-o output PDF; must differ from the input; an existing file needs --overwrite"
      },
      "overwrite": {
        "type": "boolean"
      },
      "dryRun": {
        "type": "boolean"
      },
      "preview": {
        "type": "string",
        "description": "a .png path or a folder for renders of the changed pages"
      },
      "expectHash": {
        "type": "string",
        "description": "refuse (exit 3 HASH_MISMATCH) when the input's sourceHash differs"
      },
      "flatten": {
        "type": "boolean"
      },
      "appFolder": {
        "type": "string",
        "description": "PdfNotes settings folder holding the window markers (default: the app's)"
      }
    }
  },
  "output": {
    "type": "object",
    "required": [
      "ok",
      "command",
      "sourceHash",
      "count",
      "deleted",
      "dryRun",
      "flatten",
      "output",
      "outputHash",
      "pageCount",
      "pageIds",
      "previews"
    ],
    "additionalProperties": false,
    "properties": {
      "ok": {
        "const": true
      },
      "command": {
        "const": "annot delete"
      },
      "sourceHash": {
        "$ref": "common.json#/$defs/sourceHash"
      },
      "count": {
        "type": "integer"
      },
      "deleted": {
        "type": "array",
        "items": {
          "$ref": "common.json#/$defs/annotationRef"
        }
      },
      "dryRun": {
        "type": "boolean"
      },
      "flatten": {
        "type": "boolean"
      },
      "output": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "outputHash": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "pageCount": {
        "type": "integer"
      },
      "pageIds": {
        "type": "array",
        "items": {
          "$ref": "common.json#/$defs/pageId"
        }
      },
      "previews": {
        "anyOf": [
          {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "page",
                "pageId",
                "path",
                "pageToPixel",
                "pixelToPage"
              ],
              "additionalProperties": false,
              "properties": {
                "page": {
                  "type": "integer"
                },
                "pageId": {
                  "$ref": "common.json#/$defs/pageId"
                },
                "path": {
                  "type": "string"
                },
                "pageToPixel": {
                  "$ref": "common.json#/$defs/matrix"
                },
                "pixelToPage": {
                  "$ref": "common.json#/$defs/matrix"
                }
              }
            }
          },
          {
            "type": "null"
          }
        ]
      }
    }
  }
}
