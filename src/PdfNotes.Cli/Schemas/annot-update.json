{
  "input": {
    "type": "object",
    "description": "deot annot update <pdf> (--id <id> | --source-key <key>) [options] [--allow-untagged]. Options by kind: text --text <formatted text> (replaces the text; the style is the box's own plus --style), --style <json> (alone: applied to the whole box, e.g. {\"size\": 12} sets every run), --width <box width>, [--overflow error|allow] (PAGE_OVERFLOW as add text); note --text, --color; mark --color, --opacity, --height auto|pt (highlight), --width (underline, strikeout); ink and highlight-stroke --color, --opacity, --width; line --color, --opacity, --width, --dash, --start-arrow on|off, --end-arrow on|off; shape --fill, --fill-opacity, --border on|off, --border-color, --border-width, --border-opacity, --dash, --size w,h (its own box, from its top-left); image --size w,h. Geometry (not marks; notes only --move, --at): --scale s (from the bounds' top-left), --rotate deg (clockwise about the bounds' center), then --move dx,dy or --at x,y (the bounds' new top-left). An option the kind does not take is INVALID_ARGUMENT (geometry on a mark NOT_TRANSFORMABLE). The annotation keeps its ID and stacking position and takes the run's batch id. Only annotations the CLI made (tag author \"ai\") change: others give FORBIDDEN (exit 2) unless --allow-untagged. Errors also: ANNOTATION_NOT_FOUND, LOCKED_ANNOTATION (2), and the write errors (SAME_AS_INPUT, OUTPUT_EXISTS, HASH_MISMATCH, FILE_OPEN_IN_APP).",
    "required": [
      "pdf"
    ],
    "properties": {
      "pdf": {
        "type": "string"
      },
      "id": {
        "type": "string",
        "description": "annotation ID"
      },
      "sourceKey": {
        "type": "string",
        "description": "or: the AI annotation with this source key"
      },
      "text": {
        "type": "string",
        "description": "formatted text: JSON list [{text, bold, italic, underline, strikeout, color, size, font, highlight (#RRGGBB or true), highlightOpacity}], @file with that list, or plain text with **bold** *italic* __underline__ ~~strikeout~~ ==highlight== (backslash escapes)"
      },
      "style": {
        "type": "string",
        "description": "style JSON: font, size, color #RRGGBB, bold, italic, alignment left|center|right, background, backgroundOpacity, border, borderColor, borderOpacity, highlightColor, highlightOpacity"
      },
      "width": {
        "type": "number"
      },
      "color": {
        "type": "string",
        "description": "#RRGGBB"
      },
      "opacity": {
        "type": "number"
      },
      "height": {
        "type": "string"
      },
      "dash": {
        "enum": [
          "solid",
          "dash",
          "dot",
          "dash-dot"
        ]
      },
      "fill": {
        "type": "string",
        "description": "#RRGGBB"
      },
      "fillOpacity": {
        "type": "number"
      },
      "border": {
        "enum": [
          "on",
          "off"
        ]
      },
      "borderColor": {
        "type": "string",
        "description": "#RRGGBB"
      },
      "borderWidth": {
        "type": "number"
      },
      "borderOpacity": {
        "type": "number"
      },
      "startArrow": {
        "enum": [
          "on",
          "off"
        ]
      },
      "endArrow": {
        "enum": [
          "on",
          "off"
        ]
      },
      "size": {
        "type": "string",
        "description": "w,h"
      },
      "scale": {
        "type": "number"
      },
      "rotate": {
        "type": "number"
      },
      "move": {
        "type": "string",
        "description": "dx,dy"
      },
      "at": {
        "type": "string",
        "description": "x,y"
      },
      "overflow": {
        "enum": [
          "error",
          "allow"
        ]
      },
      "allowUntagged": {
        "type": "boolean"
      },
      "out": {
        "type": "string",
        "description": "-o output PDF; must differ from the input; an existing file needs --overwrite"
      },
      "overwrite": {
        "type": "boolean"
      },
      "dryRun": {
        "type": "boolean"
      },
      "preview": {
        "type": "string",
        "description": "a .png path or a folder for renders of the changed pages"
      },
      "expectHash": {
        "type": "string",
        "description": "refuse (exit 3 HASH_MISMATCH) when the input's sourceHash differs"
      },
      "batchId": {
        "type": "string"
      },
      "flatten": {
        "type": "boolean"
      },
      "appFolder": {
        "type": "string",
        "description": "PdfNotes settings folder holding the window markers (default: the app's)"
      }
    }
  },
  "output": {
    "type": "object",
    "required": [
      "ok",
      "command",
      "sourceHash",
      "annotation",
      "changed",
      "warnings",
      "dryRun",
      "flatten",
      "output",
      "outputHash",
      "pageCount",
      "pageIds",
      "previews"
    ],
    "additionalProperties": false,
    "properties": {
      "ok": {
        "const": true
      },
      "command": {
        "const": "annot update"
      },
      "sourceHash": {
        "$ref": "common.json#/$defs/sourceHash"
      },
      "annotation": {
        "$ref": "common.json#/$defs/annotation"
      },
      "changed": {
        "type": "boolean"
      },
      "rect": {
        "$ref": "common.json#/$defs/rect",
        "description": "text: the final rectangle"
      },
      "layout": {
        "type": "object",
        "required": [
          "width",
          "height",
          "lineCount",
          "lines",
          "fonts",
          "substitutions",
          "missingGlyphs",
          "effectiveStyle"
        ],
        "additionalProperties": false,
        "properties": {
          "width": {
            "type": "number"
          },
          "height": {
            "type": "number"
          },
          "lineCount": {
            "type": "integer"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "start",
                "end",
                "text",
                "rect"
              ],
              "additionalProperties": false,
              "properties": {
                "start": {
                  "type": "integer"
                },
                "end": {
                  "type": "integer"
                },
                "text": {
                  "type": "string"
                },
                "rect": {
                  "$ref": "common.json#/$defs/rect"
                }
              },
              "description": "UTF-16 range; rect in box coordinates (origin at the box's top-left)"
            }
          },
          "fonts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "start",
                "end",
                "requested",
                "font"
              ],
              "additionalProperties": false,
              "properties": {
                "start": {
                  "type": "integer"
                },
                "end": {
                  "type": "integer"
                },
                "requested": {
                  "type": "string"
                },
                "font": {
                  "type": "string"
                }
              }
            }
          },
          "substitutions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "start",
                "end",
                "text",
                "requested",
                "font"
              ],
              "additionalProperties": false,
              "properties": {
                "start": {
                  "type": "integer"
                },
                "end": {
                  "type": "integer"
                },
                "text": {
                  "type": "string"
                },
                "requested": {
                  "type": "string"
                },
                "font": {
                  "type": "string"
                }
              }
            }
          },
          "missingGlyphs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "start",
                "end",
                "text",
                "codepoints"
              ],
              "additionalProperties": false,
              "properties": {
                "start": {
                  "type": "integer"
                },
                "end": {
                  "type": "integer"
                },
                "text": {
                  "type": "string"
                },
                "codepoints": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "fits": {
            "type": "boolean"
          },
          "requiredHeight": {
            "type": "number"
          },
          "overflowHeight": {
            "type": "number"
          },
          "effectiveStyle": {
            "type": "object",
            "required": [
              "font",
              "fontUsed",
              "size",
              "color",
              "bold",
              "italic",
              "alignment",
              "lineSpacing",
              "padding",
              "borderWidth",
              "minHeight",
              "background",
              "backgroundOpacity",
              "border",
              "borderColor",
              "borderOpacity",
              "highlightColor",
              "highlightOpacity"
            ],
            "additionalProperties": false,
            "properties": {
              "font": {
                "type": "string"
              },
              "fontUsed": {
                "type": "string"
              },
              "size": {
                "type": "number"
              },
              "color": {
                "type": "string"
              },
              "bold": {
                "type": "boolean"
              },
              "italic": {
                "type": "boolean"
              },
              "alignment": {
                "enum": [
                  "left",
                  "center",
                  "right"
                ]
              },
              "lineSpacing": {
                "type": "string"
              },
              "padding": {
                "type": "number"
              },
              "borderWidth": {
                "type": "number"
              },
              "minHeight": {
                "type": "number"
              },
              "background": {
                "type": "string"
              },
              "backgroundOpacity": {
                "type": "number"
              },
              "border": {
                "type": "boolean"
              },
              "borderColor": {
                "type": "string"
              },
              "borderOpacity": {
                "type": "number"
              },
              "highlightColor": {
                "type": "string"
              },
              "highlightOpacity": {
                "type": "number"
              }
            }
          }
        },
        "description": "text with --text, --style or --width: the measure result"
      },
      "warnings": {
        "type": "array",
        "items": {
          "$ref": "common.json#/$defs/warning"
        }
      },
      "dryRun": {
        "type": "boolean"
      },
      "flatten": {
        "type": "boolean"
      },
      "output": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "outputHash": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "pageCount": {
        "type": "integer"
      },
      "pageIds": {
        "type": "array",
        "items": {
          "$ref": "common.json#/$defs/pageId"
        }
      },
      "previews": {
        "anyOf": [
          {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "page",
                "pageId",
                "path",
                "pageToPixel",
                "pixelToPage"
              ],
              "additionalProperties": false,
              "properties": {
                "page": {
                  "type": "integer"
                },
                "pageId": {
                  "$ref": "common.json#/$defs/pageId"
                },
                "path": {
                  "type": "string"
                },
                "pageToPixel": {
                  "$ref": "common.json#/$defs/matrix"
                },
                "pixelToPage": {
                  "$ref": "common.json#/$defs/matrix"
                }
              }
            }
          },
          {
            "type": "null"
          }
        ]
      }
    }
  }
}
