{
  "input": {
    "type": "object",
    "description": "deot page resize <pdf> (-p | --pages) --size w,h (pt) [--mode fit|clip] [--anchor …]. fit shrinks the content when it does not fit; clip keeps its size (spec 11.7-11.8). Common: -o <pdf> [--overwrite] | --dry-run, [--preview png|folder] [--expect-hash h] [--flatten]. Errors: SAME_AS_INPUT, OUTPUT_EXISTS, HASH_MISMATCH (3), FILE_OPEN_IN_APP (3).",
    "required": [
      "pdf",
      "size"
    ],
    "properties": {
      "pdf": {
        "type": "string"
      },
      "page": {
        "type": "string"
      },
      "pages": {
        "type": "string"
      },
      "size": {
        "type": "string"
      },
      "mode": {
        "enum": [
          "fit",
          "clip"
        ]
      },
      "anchor": {
        "type": "string"
      },
      "out": {
        "type": "string",
        "description": "-o output PDF; must differ from the input; an existing file needs --overwrite"
      },
      "overwrite": {
        "type": "boolean"
      },
      "dryRun": {
        "type": "boolean"
      },
      "preview": {
        "type": "string",
        "description": "a .png path or a folder for renders of the changed pages"
      },
      "expectHash": {
        "type": "string",
        "description": "refuse (exit 3 HASH_MISMATCH) when the input's sourceHash differs"
      },
      "batchId": {
        "type": "string"
      },
      "flatten": {
        "type": "boolean"
      },
      "appFolder": {
        "type": "string",
        "description": "PdfNotes settings folder holding the window markers (default: the app's)"
      }
    }
  },
  "output": {
    "type": "object",
    "required": [
      "ok",
      "command",
      "sourceHash",
      "pageTransforms",
      "dryRun",
      "flatten",
      "output",
      "outputHash",
      "pageCount",
      "pageIds",
      "previews"
    ],
    "additionalProperties": false,
    "properties": {
      "ok": {
        "const": true
      },
      "command": {
        "const": "page resize"
      },
      "sourceHash": {
        "$ref": "common.json#/$defs/sourceHash"
      },
      "pageTransforms": {
        "type": "array",
        "items": {
          "$ref": "common.json#/$defs/pageTransform"
        }
      },
      "dryRun": {
        "type": "boolean"
      },
      "flatten": {
        "type": "boolean"
      },
      "output": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "outputHash": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "pageCount": {
        "type": "integer"
      },
      "pageIds": {
        "type": "array",
        "items": {
          "$ref": "common.json#/$defs/pageId"
        }
      },
      "previews": {
        "anyOf": [
          {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "page",
                "pageId",
                "path",
                "pageToPixel",
                "pixelToPage"
              ],
              "additionalProperties": false,
              "properties": {
                "page": {
                  "type": "integer"
                },
                "pageId": {
                  "$ref": "common.json#/$defs/pageId"
                },
                "path": {
                  "type": "string"
                },
                "pageToPixel": {
                  "$ref": "common.json#/$defs/matrix"
                },
                "pixelToPage": {
                  "$ref": "common.json#/$defs/matrix"
                }
              }
            }
          },
          {
            "type": "null"
          }
        ]
      }
    }
  }
}
