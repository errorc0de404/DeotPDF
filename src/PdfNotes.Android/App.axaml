<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PdfNotes.Android.App"
             RequestedThemeVariant="Default">
    <!-- The same looks as the desktop app (PdfNotes.Desktop/App.axaml): Fluent under the app's tokens and controls. -->
    <Application.Styles>
        <FluentTheme DensityStyle="Compact" />
        <StyleInclude Source="avares://PdfNotes.UI/Themes/Styles.axaml" />
    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://PdfNotes.UI/Themes/Tokens.axaml" />
                <ResourceInclude Source="avares://PdfNotes.UI/Themes/Colors.axaml" />
                <ResourceInclude Source="avares://PdfNotes.UI/Themes/Controls.axaml" />
                <!-- P5c: room for a finger -->
                <ResourceInclude Source="avares://PdfNotes.UI/Themes/Touch.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
