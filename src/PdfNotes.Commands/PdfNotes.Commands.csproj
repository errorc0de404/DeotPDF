<Project Sdk="Microsoft.NET.Sdk">
  <!-- The commands of deot (cli_plan) as a library: the deot exe runs them on files, and the desktop app runs the same
       code on the document it has open when an AI client asks through deot (MCP_LIVE_PLAN 8.2). -->
  <PropertyGroup>
    <IsRidAgnostic>true</IsRidAgnostic>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PdfNotes.Cli</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PdfNotes.Core/PdfNotes.Core.csproj" />
    <ProjectReference Include="../PdfNotes.Editor/PdfNotes.Editor.csproj" />
    <ProjectReference Include="../PdfNotes.Pdf/PdfNotes.Pdf.csproj" />
    <ProjectReference Include="../PdfNotes.Text/PdfNotes.Text.csproj" />
    <ProjectReference Include="../PdfNotes.Text.Skia/PdfNotes.Text.Skia.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="deot" />
    <InternalsVisibleTo Include="PdfNotes.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Schemas/*.json" LogicalName="PdfNotes.Cli.Schemas.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
