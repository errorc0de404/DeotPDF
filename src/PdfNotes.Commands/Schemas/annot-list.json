{
  "input": {
    "type": "object",
    "description": "deot annot list <pdf> [-p <page>] [--kind text|mark|highlight-stroke|line|shape|ink|image|note|table] [--tag tagged|untagged] [--author <a>] [--batch-id <id>] [--source-key <key>] [--group-key <key>] [--near-text]. --tag untagged is the user's own writing (and other apps' annotations). --near-text adds nearText to each: the PDF text line it lies on or nearest to {start, end, text, quad, distance} (null on a page without text) - which answer a mark is on, which question a note sits beside.",
    "required": [
      "pdf"
    ],
    "properties": {
      "pdf": {
        "type": "string"
      },
      "page": {
        "type": "string"
      },
      "kind": {
        "type": "string"
      },
      "tag": {
        "enum": [
          "tagged",
          "untagged"
        ]
      },
      "author": {
        "type": "string"
      },
      "batchId": {
        "type": "string"
      },
      "sourceKey": {
        "type": "string"
      },
      "groupKey": {
        "type": "string"
      },
      "nearText": {
        "type": "boolean"
      }
    }
  },
  "output": {
    "type": "object",
    "required": [
      "ok",
      "command",
      "sourceHash",
      "count",
      "annotations"
    ],
    "additionalProperties": false,
    "properties": {
      "ok": {
        "const": true
      },
      "command": {
        "const": "annot list"
      },
      "sourceHash": {
        "$ref": "common.json#/$defs/sourceHash"
      },
      "count": {
        "type": "integer"
      },
      "annotations": {
        "type": "array",
        "items": {
          "$ref": "common.json#/$defs/annotation"
        }
      }
    }
  }
}
