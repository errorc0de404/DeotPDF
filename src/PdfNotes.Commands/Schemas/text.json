{
  "input": {
    "type": "object",
    "description": "deot text <pdf> -p <page> [--fields chars,words,lines,tables] [--region x,y,w,h]. chars is long (one entry per character): for reading, ask for --fields lines,tables. tables are the table annotations on the page with their cell texts (cells[row][column]); their text is not in the text layer. --region keeps what touches the rectangle; numbers stay those of the whole page.",
    "required": ["pdf", "page"],
    "properties": {
      "pdf": { "type": "string" },
      "page": { "type": "string", "description": "1-based number or page ID" },
      "fields": { "type": "string", "description": "comma list of chars, words, lines, tables (default all)" },
      "region": { "type": "string", "description": "canonical x,y,w,h" }
    }
  },
  "output": {
    "type": "object",
    "required": ["ok", "command", "sourceHash", "page", "pageId", "hasText", "charCount"],
    "additionalProperties": false,
    "properties": {
      "ok": { "const": true },
      "command": { "const": "text" },
      "sourceHash": { "$ref": "common.json#/$defs/sourceHash" },
      "page": { "type": "integer" },
      "pageId": { "$ref": "common.json#/$defs/pageId" },
      "hasText": { "type": "boolean" },
      "charCount": { "type": "integer" },
      "chars": {
        "type": "array",
        "description": "PDF text layer in reading order. index = 0-based character number (PDFium order of the source page); quad is null for generated characters (spaces, line ends) without a shape.",
        "items": {
          "type": "object",
          "required": ["index", "text", "quad"],
          "additionalProperties": false,
          "properties": { "index": { "type": "integer" }, "text": { "type": "string" }, "quad": { "anyOf": [{ "$ref": "common.json#/$defs/quad" }, { "type": "null" }] } }
        }
      },
      "words": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["start", "end", "text", "quads"],
          "additionalProperties": false,
          "properties": { "start": { "type": "integer" }, "end": { "type": "integer" }, "text": { "type": "string" }, "quads": { "type": "array", "items": { "$ref": "common.json#/$defs/quad" } } }
        }
      },
      "lines": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["start", "end", "text", "quad"],
          "additionalProperties": false,
          "properties": { "start": { "type": "integer" }, "end": { "type": "integer" }, "text": { "type": "string" }, "quad": { "$ref": "common.json#/$defs/quad" } }
        }
      },
      "tables": {
        "type": "array",
        "description": "table annotations on the page (with --region: those whose bounds touch it); their cells are not in the text layer",
        "items": {
          "type": "object",
          "required": ["id", "bounds", "rows", "columns", "cells"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "bounds": { "$ref": "common.json#/$defs/rect" },
            "rows": { "type": "integer" },
            "columns": { "type": "integer" },
            "cells": { "type": "array", "description": "cells[row][column] text", "items": { "type": "array", "items": { "type": "string" } } }
          }
        }
      }
    }
  }
}
