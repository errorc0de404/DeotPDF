{
  "input": {
    "type": "object",
    "description": "deot annot list <pdf> [-p <page>] [--kind text|mark|highlight-stroke|line|shape|ink|image|note] [--tag tagged|untagged] [--author <a>] [--batch-id <id>] [--source-key <key>] [--group-key <key>]",
    "required": [
      "pdf"
    ],
    "properties": {
      "pdf": {
        "type": "string"
      },
      "page": {
        "type": "string"
      },
      "kind": {
        "type": "string"
      },
      "tag": {
        "enum": [
          "tagged",
          "untagged"
        ]
      },
      "author": {
        "type": "string"
      },
      "batchId": {
        "type": "string"
      },
      "sourceKey": {
        "type": "string"
      },
      "groupKey": {
        "type": "string"
      }
    }
  },
  "output": {
    "type": "object",
    "required": [
      "ok",
      "command",
      "sourceHash",
      "count",
      "annotations"
    ],
    "additionalProperties": false,
    "properties": {
      "ok": {
        "const": true
      },
      "command": {
        "const": "annot list"
      },
      "sourceHash": {
        "$ref": "common.json#/$defs/sourceHash"
      },
      "count": {
        "type": "integer"
      },
      "annotations": {
        "type": "array",
        "items": {
          "$ref": "common.json#/$defs/annotation"
        }
      }
    }
  }
}
